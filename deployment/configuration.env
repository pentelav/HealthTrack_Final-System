
# Defining application information
APP_NAME=HealthTrack Healthcare Monitoring System

APP_VERSION=Final-1.0



# Defining backend configuration
BACKEND_HOST=127.0.0.1

BACKEND_PORT=8000



# Defining dashboard configuration
DASHBOARD_HOST=127.0.0.1

DASHBOARD_PORT=8050



# Defining database configuration
DATABASE_TYPE=mysql

DATABASE_HOST=localhost

DATABASE_PORT=3306

DATABASE_NAME=HealthTrackDB

DATABASE_USER=root

DATABASE_PASSWORD=password



# Defining security configuration
JWT_SECRET_KEY=HealthTrack_Final_Project_Secret_Key

JWT_EXPIRATION_MINUTES=60



# Defining alert threshold values
HEART_RATE_LIMIT=120

OXYGEN_LIMIT=90

TEMPERATURE_LIMIT=38.5



# Defining machine learning model path
MODEL_PATH=../risk-assessment/risk_model.pkl



# Defining logging configuration
LOG_LEVEL=INFO